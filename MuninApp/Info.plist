<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(APP_BUNDLE_ID).otpauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>otpauth</string>
				<string>otpauth-migration</string>
			</array>
		</dict>
	</array>
	<key>MuninAPIHost</key>
	<string>$(MUNIN_API_HOST)</string>
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>SupabasePublishableKey</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<key>MuninKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(APP_BUNDLE_ID).shared</string>
</dict>
</plist>
