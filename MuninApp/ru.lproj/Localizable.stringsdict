		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Осталось %lld секунды</string>
			<key>many</key>
			<string>Осталось %lld секунд</string>
			<key>one</key>
			<string>Осталась %lld секунда</string>
			<key>other</key>
			<string>Осталось %lld секунды</string>
		</dict>
	</dict>
