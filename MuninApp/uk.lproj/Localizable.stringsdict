		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld записи не вдалося розшифрувати ключем цього пристрою.</string>
			<key>many</key>
			<string>%lld записів не вдалося розшифрувати ключем цього пристрою.</string>
			<key>one</key>
