default_platform(:ios)

APP_ID = "dev.gidlof.Munin"
AUTOFILL_ID = "dev.gidlof.Munin.AutoFill"
PROJECT = "MuninApp.xcodeproj"
SCHEME = "MuninApp"

# The App Store Connect API key. On CI, the key comes from repository secrets.
def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"),
    in_house: false
  )
end

# Installs the App Store certificates and profiles for a platform, and switches
# the app and AutoFill targets to manual signing with them.
#
# Returns the bundle identifier → profile name mapping for the export options.
def install_signing(platform:, key:)
  match(
    api_key: key,
    platform: platform,
    additional_cert_types: platform == "macos" ? ["mac_installer_distribution"] : nil,
    readonly: is_ci
  )
  profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

  RELEASE_CONFIGURATIONS.each do |configuration, identifier|
    use_manual_signing(configuration, profile: profiles.fetch(identifier))
  end
  profiles
end

# The Release build configurations of the app and AutoFill targets, by object ID.
RELEASE_CONFIGURATIONS = {
  "000000000000000112000000" => APP_ID,
  "D542114C3097CF4900FD91D4" => AUTOFILL_ID
}.freeze

# Switches one build configuration to manual signing with an App Store profile.
#
# This edits `project.pbxproj` as text instead of using `update_code_signing_settings`:
# that action rewrites the whole file with a parser that drops keys it doesn't know,
# such as `dstSubfolder` on the Embed Foundation Extensions phase, which leaves the
# AutoFill extension outside the app in the archive.
def use_manual_signing(configuration, profile:)
  path = File.expand_path("../#{PROJECT}/project.pbxproj", __dir__)
  project = File.read(path)
  pattern = /(\t\t#{configuration} \/\*.*?\*\/ = \{\n\t\t\tisa = XCBuildConfiguration;\n\t\t\tbuildSettings = \{\n)(.*?)(\n\t\t\t\};)/m
  updated = project.sub(pattern) do
    head, settings, tail = Regexp.last_match(1), Regexp.last_match(2), Regexp.last_match(3)
    settings = settings.lines.reject { |line| line =~ /^\t+(CODE_SIGN_STYLE|CODE_SIGN_IDENTITY|PROVISIONING_PROFILE_SPECIFIER) = / }.join
    signing = "\t\t\t\tCODE_SIGN_IDENTITY = \"Apple Distribution\";\n" \
              "\t\t\t\tCODE_SIGN_STYLE = Manual;\n" \
              "\t\t\t\tPROVISIONING_PROFILE_SPECIFIER = \"#{profile}\";\n"
    "#{head}#{signing}#{settings.chomp}#{tail}"
  end
  UI.user_error!("Build configuration #{configuration} not found in #{path}") if updated == project
  File.write(path, updated)
end

desc "Creates or updates the App Store certificates and profiles for iOS and macOS. Run locally once."
lane :certificates do
  key = api_key
  match(api_key: key, platform: "ios")
  match(api_key: key, platform: "macos", additional_cert_types: ["mac_installer_distribution"])
end

platform :ios do
  desc "Archives the iOS app and uploads it to TestFlight"
  lane :release_testflight do
    setup_ci if is_ci
    key = api_key
    profiles = install_signing(platform: "ios", key: key)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_options: { provisioningProfiles: profiles },
      output_directory: "build/ios"
    )

    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end
end

platform :mac do
  desc "Archives the macOS app and uploads it to TestFlight"
  lane :release_testflight do
    setup_ci if is_ci
    key = api_key
    profiles = install_signing(platform: "macos", key: key)

    build_mac_app(
      project: PROJECT,
      scheme: SCHEME,
      destination: "generic/platform=macOS",
      export_method: "app-store",
      export_options: { provisioningProfiles: profiles },
      output_directory: "build/macos"
    )

    upload_to_testflight(
      api_key: key,
      app_platform: "osx",
      pkg: lane_context[SharedValues::PKG_OUTPUT_PATH],
      skip_waiting_for_build_processing: true
    )
  end
end
